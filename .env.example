# ============================================================
# APPLICATION CONFIG
# ============================================================
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ============================================================
# FASTAPI & SERVER
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql+asyncpg://workload:workload_pass@localhost:5432/workload_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=86400

# ============================================================
# JWT & SECURITY
# ============================================================
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ============================================================
# SLACK OAUTH
# ============================================================
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/auth/slack/callback
SLACK_BOT_TOKEN=your_slack_bot_token

# ============================================================
# JIRA OAUTH
# ============================================================
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/jira/callback

# ============================================================
# LLM PROVIDERS
# ============================================================
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile

MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-large-latest

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================================
# BACKGROUND JOBS
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
DRAMATIQ_BROKER=redis

# ============================================================
# OBSERVABILITY
# ============================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================================
# INTEGRATIONS & SYNC
# ============================================================
SYNC_INTERVAL_HOURS=1
GMAIL_BATCH_SIZE=100
SLACK_BATCH_SIZE=50
JIRA_BATCH_SIZE=50
CALENDAR_BATCH_SIZE=100

# ============================================================
# ENCRYPTION
# ============================================================
ENCRYPTION_KEY=your_encryption_key

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_AI_EXTRACTION=true
FEATURE_SCHEDULING=true
FEATURE_WORKLOAD_DETECTION=true
FEATURE_OVERLOAD_ALERTS=true

# ============================================================
# CORS & SECURITY
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# MCP
# ============================================================
MCP_SERVER_PROTOCOL=stdio
MCP_REQUEST_TIMEOUT_SECONDS=300
